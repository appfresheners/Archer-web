# =============================================================
# Archer app runtime configuration
# Copy this file to `.env` (in the archer/ directory) and fill in your key.
# This file is loaded into the container via docker-compose `env_file`.
# Never commit the real `.env` — it is gitignored.
# =============================================================

# Set AI_PROVIDER to one of: openai | gemini | groq
AI_PROVIDER=gemini

# --- Google Gemini (free tier) — https://aistudio.google.com/apikey ---
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# --- Groq (free tier) — https://console.groq.com ---
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.1-8b-instant

# --- OpenAI (paid) — https://platform.openai.com/api-keys ---
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
