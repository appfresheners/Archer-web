# =============================================================
# Archer app runtime configuration
# Copy this file to `.env.local` (in the archer/ directory) and fill in your keys.
# `.env.local` is loaded automatically by Next.js for local dev/build/start AND
# into the container via docker-compose `env_file`, so one file drives both.
# Never commit the real `.env.local` — it is gitignored (.env*).
# =============================================================

# Set AI_PROVIDER to one of: openai | gemini | groq
AI_PROVIDER=gemini

# --- Google Gemini (free tier) — https://aistudio.google.com/apikey ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Groq (free tier) — https://console.groq.com ---
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.1-8b-instant

# --- OpenAI (paid) — https://platform.openai.com/api-keys ---
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# =============================================================
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Project Settings → API. Required for auth and data persistence.
# =============================================================

# Public project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public publishable key (safe to expose to the browser; RLS-guarded).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy anon key is also supported as a fallback.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role/secret key — SERVER ROUTE HANDLERS ONLY. Bypasses RLS.
# Never expose to the browser and never reference in client/middleware code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
