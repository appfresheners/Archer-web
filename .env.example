# =============================================================
# Docker Compose configuration
# Copy this file to `.env` (same directory) and adjust the values.
# `.env` is read automatically by `docker compose`.
# =============================================================

# Public hostname your (separately managed) Traefik routes to the app.
# Local development: use "localhost".
# Production:        use your real domain, e.g. archer.example.com
DOMAIN=localhost

# NOTE: The app's own runtime secrets (AI provider keys) live in
# archer/.env — copy archer/.env.example to archer/.env and fill those in.
#
# TLS / Let's Encrypt (ACME email, cert resolver, entrypoints) is configured
# in your own Traefik setup, not here.
