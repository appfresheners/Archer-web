# Dependencies (reinstalled inside the image)
node_modules
.pnp
.pnp.*

# Build output (regenerated by next build)
.next
out
build

# Secrets / local env — never copy into the build context
.env
.env.*
!.env.example

# Tests & tooling not needed for the production runtime
coverage
*.test.ts
*.test.tsx
**/*.test.ts
**/*.test.tsx
vitest.config.ts
vitest.setup.ts
eslint.config.mjs

# VCS & editor
.git
.gitignore
.vscode
.idea

# Misc
*.tsbuildinfo
npm-debug.log*
Dockerfile
.dockerignore
README.md
